# Copy to .env.local and fill in. Restart `npm run dev` after any change.
# Only variables starting with VITE_ reach the browser code.

# Servers
VITE_CLIENT_API_URL=https://ott.tvanywhereafrica.com:28182
VITE_CM_URL=https://tvanywhereonline.com/cm

# Operator (from the MTN TV+ brief)
# Which operator to run as: a name from src/app-settings/operators.js (its id + username prefix come from there)
VITE_OPERATOR_UID=
# Country calling code without "+" (Ghana = 233)
VITE_COUNTRY_CALLING_CODE=233

# CRM network-check headers (never commit real values)
VITE_CM_USERNAME=
VITE_CM_PASSWORD=

# Public image key used in image URLs
VITE_IMAGE_ACCESS_KEY=

# Dev only: skip sign-in while building screens
VITE_BYPASS_AUTH=true

# The one shared password every account uses behind the scenes (sign-in is phone + code only)
VITE_DEFAULT_PASSWORD=
